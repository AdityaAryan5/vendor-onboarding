# Local default. npm run dev starts embedded Postgres only in development.
DATABASE_URL=postgresql://demo:demo@127.0.0.1:55432/vendor_onboarding
# Hosted: Neon pooled URL above; optional direct (non-pooler) URL for migrations.
DIRECT_DATABASE_URL=
BANK_HASH_KEY=local-demo-bank-key-change-before-hosting-2026
SESSION_SECRET=local-demo-session-key-change-before-hosting-2026
# Synthetic public dashboard. Vendor status and mutations remain session-private.
DEMO_WORKSPACE=true
# Minimum visible stage time, including processing. Set 0 for fast unit/integration runs.
STAGE_MIN_DISPLAY_MS=500
# Dev only: auto-detect optional Poppler/Tesseract. Production always ignores OCR.
OCR_ENABLED=true
# Optional password gate. A public synthetic workspace may leave this blank.
DEMO_ACCESS_PASSWORD=

# Basic shared PostgreSQL quotas per IP / fixed minute.
RATE_LIMIT_WRITE=20
RATE_LIMIT_SESSION=30
RATE_LIMIT_READ=1200
# Leave false for direct local hosting and Vercel.
TRUST_PROXY_IP=false


# Fixed Scenario Runner fixtures and their owner-scoped polls are exempt.
# RATE_LIMIT_WRITE / READ / SESSION govern ordinary traffic.
